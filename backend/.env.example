# =============================================================================
# Global Sports Live TV — Backend (FastAPI) — TEMPLATE ONLY
# কপি করে .env বানান:  cp .env.example .env
# Never commit .env. Production এ শক্তish JWT, নিরাপদ admin পাসওয়ার্ড, সঠিক CORS।
# =============================================================================

# --- App ---
APP_NAME=Global Sports Live TV API
# development | production (production এ placeholder JWT নিষিদ্ধ)
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database ---
# খালি রাখলে sqlite_fallback_url (সাধারণত ./sports_tv.db)। প্রোডে Neon/Render Postgres:
# postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=
SQLITE_FALLBACK_URL=sqlite:///./sports_tv.db
# Neon free: keep sum small (e.g. 5+10) — total connections are shared with pooler/branch
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Auth (JWT) ---
# openssl rand -hex 32 এ জেনারেট করতে পারেন
JWT_SECRET_KEY=replace-with-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Seeded admin (first run). Production এ এগুলো বদলান ---
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=Admin12345!
ADMIN_FULL_NAME=Platform Admin

# true = each startup removes every user except ADMIN_EMAIL. false = keep registered users (e.g. open signup)
PRUNE_NON_DEFAULT_USERS_ON_STARTUP=true

# --- CORS: comma, no trailing slash. Local + production Vercel. Preview *.vercel.app: see app/main.py regex.
CORS_ORIGINS=http://localhost:3000

# --- POST /internal/sync (prod: required random secret; header X-Sync-Secret) ---
# INTERNAL_SYNC_SECRET=

# --- M3U / sync ---
SCRAPER_SOURCE_URL=https://iptv-org.github.io/iptv/categories/sports.m3u
# স্টার্টআপে যদি চ্যানেল 0 হয় তবে একবার sync (ঐচ্ছিক)
AUTO_SYNC_CHANNELS_ON_STARTUP=false
# POST /admin/channels/sync রেট লিমিট (সেকেন্ড, প্রসেস-লোকাল)
SYNC_RATE_LIMIT_SECONDS=60
# Legacy DB M3U sync — viewer uses frontend M3U. 0 = off. Production blueprint may use 120 (every 2h).
SCHEDULED_SYNC_INTERVAL_MINUTES=0
# Sample streams and deactivate dead URLs. 0 = off. Match or exceed sync interval on small hosts (e.g. 120).
STREAM_VALIDATION_INTERVAL_MINUTES=0
# Discover new M3U sources (0 = off; free tier: keep 0).
SOURCE_DISCOVERY_INTERVAL_HOURS=0
# Dynamic m3u8 refresh via Playwright (0 = off; free tier: keep 0 — high RAM).
M3U8_REFRESH_INTERVAL_MINUTES=0

# --- T-Sports (proxy: /api/v1/proxy/stream?header_profile=tsports) ---
# Paste a fresh Edge-Cache-Cookie when the CDN returns 403 (tokens expire).
# If the value contains # or spaces, wrap in double quotes.
STREAM_PROFILE_TSPORTS_COOKIE=Edge-Cache-Cookie=URLPrefix=aHR0cHM6Ly9saXZlLWNkbi50c3BvcnRzLmNvbS8:Expires=1705007554:KeyName=tsports-ed25519-01:Signature=rvsNaCDMRsm4df7UmpXAmNVWkyrPnXRCoSYE_v3aVvldpT3qJLFq6E-MgqU1Eq-G4hu2maHLVCwPua4gQVJ-DQ
STREAM_PROFILE_TSPORTS_USER_AGENT=(Linux;Android 14)

# --- Redis (Redis Cloud free / Upstash) — GET channels/filters ক্যাশ। না দিলে in-process fallback
# REDIS_URL=redis://localhost:6379/0
# REDIS_URL=rediss://:password@host:6379
REDIS_URL=
# ক্যাশ TTL (সেকেন্ড) — ৫–১০ মিনিটের মধ্যে
CACHE_TTL_SECONDS=300
# GET /api/v1/proxy/playlist — M3U body cache (Redis + small in-process LRU). 3600–7200 typical.
PROXY_PLAYLIST_CACHE_TTL_SECONDS=5400

# --- Upstream geo bypass (proxy.py) — X-Forwarded-For / X-Real-IP spoof; best-effort for strict CDNs ---
STREAM_GEO_BYPASS_ENABLED=true
# Optional residential/datacenter proxy for httpx (all playlist + stream upstream requests)
# STREAM_UPSTREAM_HTTP_PROXY=http://user:pass@host:port
